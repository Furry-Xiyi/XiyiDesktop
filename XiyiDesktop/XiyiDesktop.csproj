<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>XiyiDesktop</RootNamespace>
		<Platforms>x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLower())</RuntimeIdentifier>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<WinUISDKReferences>false</WinUISDKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<PublishAot>true</PublishAot>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\SplashScreen.scale-200.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="app.manifest" />
	</ItemGroup>

	<!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.29648.1000-preview" GeneratePathProperty="true" />
		<PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.TitleBar" Version="0.1.251217-build.2433" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
		<PackageReference Include="Xiyi.WindowsAppSDK.Widgets.HostProjection" Version="0.1.5-devhome-d52734ce" />
		<PackageReference Include="AdaptiveCards.ObjectModel.WinUI3" Version="2.0.2-beta" GeneratePathProperty="true" />
		<PackageReference Include="AdaptiveCards.Rendering.WinUI3" Version="2.2.4-beta" GeneratePathProperty="true" />
		<PackageReference Include="AdaptiveCards.Templating" Version="2.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\Icon\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\Icon\windows.widget.png" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\DesktopSettings\**\*" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\AddWidget\**\*" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\SMTCWidget\**\*" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\ShortcutArrow.png" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Widgets\HostConfig*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<PropertyGroup>
		<CsWinRTIncludes>Microsoft.Windows.Widgets.Hosts</CsWinRTIncludes>
	</PropertyGroup>

	<ItemGroup>
		<Content Update="Assets\AddWidget\AppIcon.ico">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\AppIcon.ico">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\DesktopSettings\AppIcon.ico">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Dark\FastForward.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Dark\Next.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Dark\Pause.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Dark\Play.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Dark\Previous.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Dark\Rewind.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Light\FastForward.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Light\Next.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Light\Pause.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Light\Play.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Light\Previous.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\Light\Rewind.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\SMTCWidget-Screenshot.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SMTCWidget\SMTCWidget.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SplashScreen.scale-100.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SplashScreen.scale-125.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SplashScreen.scale-150.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\SplashScreen.scale-400.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<!-- Publish Properties -->
	<PropertyGroup>
		<PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
		<PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
		<PackageCertificateKeyFile>FursuitTVUWP_TemporaryKey.pfx</PackageCertificateKeyFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>False</GenerateTestArtifacts>
		<AppxBundle>Never</AppxBundle>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="C:\Users\Furry_Xiyi\.nuget\packages\microsoft.windowsappsdk.runtime\2.6.5\buildTransitive\..\include\WindowsAppSDK-VersionInfo.cs" />
	</ItemGroup>
	<ItemGroup>
	  <Content Remove="Assets\Icon\AppIcon.ico" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Assets\SMTCWidget\" />
	</ItemGroup>
	<Target Name="StageWidgetsHostWinMDForPackaging" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<_WidgetsHostWinMD Include="@(Content)" Condition="'%(Content.DefiningProjectName)' == 'Xiyi.WindowsAppSDK.Widgets.HostProjection' and '%(Content.Filename)' == 'Microsoft.Windows.Widgets.Hosts'" />
		</ItemGroup>
		<Copy SourceFiles="@(_WidgetsHostWinMD)" DestinationFiles="$(IntermediateOutputPath)Microsoft.Windows.Widgets.winmd" SkipUnchangedFiles="true" />
		<ItemGroup>
			<Content Remove="@(_WidgetsHostWinMD)" />
			<Content Include="$(IntermediateOutputPath)Microsoft.Windows.Widgets.winmd" Link="Microsoft.Windows.Widgets.winmd" CopyToOutputDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>
	<Target Name="CompilePowerSoundWin32Resources" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_PowerSoundResourceCompiler>$(PkgMicrosoft_Windows_SDK_BuildTools)\bin\10.0.29648.0\x64\rc.exe</_PowerSoundResourceCompiler>
			<_PowerSoundResourceFile>$(IntermediateOutputPath)PowerSoundEvents.res</_PowerSoundResourceFile>
		</PropertyGroup>
		<Error Condition="!Exists('$(_PowerSoundResourceCompiler)')" Text="The Windows SDK resource compiler was not found at $(_PowerSoundResourceCompiler)." />
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<Exec Command="&quot;$(_PowerSoundResourceCompiler)&quot; /nologo /I &quot;$(MSBuildProjectDirectory)&quot; /fo &quot;$(_PowerSoundResourceFile)&quot; &quot;$(MSBuildProjectDirectory)\Power\PowerSoundEvents.rc&quot;" />
		<PropertyGroup>
			<Win32Resource>$(_PowerSoundResourceFile)</Win32Resource>
		</PropertyGroup>
	</Target>
</Project>
