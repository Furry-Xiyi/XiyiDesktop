<Window
    x:Class="XiyiDesktop.Widgets.UI.WidgetPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="WindowTitleBar" Grid.Row="0" Height="32" VerticalAlignment="Top">
            <muxc:TitleBar x:Name="TitleBarArea"
                               Height="32"
                               Background="Transparent"
                               DisplayMode="Standard"
                               AutoConfigureCustomTitleBar="True" />
        </Grid>

        <NavigationView x:Name="WidgetNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="True"
                        OpenPaneLength="300"
                        SelectionChanged="WidgetNavigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <TextBlock x:Uid="WidgetPickerListHeading" Margin="16,8,8,8" FontSize="18" FontWeight="SemiBold"/>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="WidgetPickerLoading" Tag="loading" IsEnabled="False"/>
            </NavigationView.MenuItems>
            <Grid Margin="24" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <Image x:Name="WidgetIconImage" Width="48" Height="48" Stretch="Uniform" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="WidgetNameText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" MinHeight="220" Padding="12" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="WidgetPreviewImage" Stretch="Uniform"/>
                        <TextBlock x:Name="WidgetPreviewFallbackText" x:Uid="WidgetPickerPreviewUnavailable"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Opacity="0.65"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SizeButton" x:Uid="WidgetPickerSizeButton"
                                Grid.Column="0" Click="SizeButton_Click"/>
                        <Button x:Name="AddButton" x:Uid="WidgetPickerAddButton"
                                Grid.Column="1" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="AddButton_Click" IsEnabled="False"/>
                    </Grid>
                    <TextBlock x:Name="DesktopFullHint" x:Uid="WidgetPickerDesktopFullHint"
                               TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="CatalogStatusText" x:Uid="WidgetPickerLoadingStatus"
                               TextWrapping="Wrap" Opacity="0.72"/>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
