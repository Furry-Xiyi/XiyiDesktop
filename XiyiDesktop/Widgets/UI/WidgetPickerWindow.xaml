<Window
    x:Class="XiyiDesktop.Widgets.UI.WidgetPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:CommunityToolkit.WinUI.Controls"
    xmlns:widgets="using:XiyiDesktop.Widgets.UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="WindowTitleBar" Grid.Row="0" Height="32" VerticalAlignment="Top">
            <muxc:TitleBar x:Name="TitleBarArea"
                               Height="32"
                               Background="Transparent"
                               DisplayMode="Standard"
                               AutoConfigureCustomTitleBar="True" />
        </Grid>

        <NavigationView x:Name="WidgetNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="WidgetNavigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <TextBlock x:Uid="WidgetPickerListHeading" Margin="16,8,8,8" FontSize="18" FontWeight="SemiBold"/>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="WidgetPickerLoading" Tag="loading" IsEnabled="False"/>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <FlipView x:Name="WidgetFlipView" Padding="0" Background="Transparent"
                              Visibility="Collapsed" IsHitTestVisible="True"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              SelectionChanged="WidgetFlipView_SelectionChanged">
                        <FlipView.ItemTemplate>
                            <DataTemplate>
                                <widgets:WidgetPickerPageControl EntryObject="{Binding}" />
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>
                    <Border x:Name="SinglePreviewCard" MaxWidth="300" MaxHeight="462"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Translation="0,0,32"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid>
                            <Image x:Name="SinglePreviewImage" Stretch="Uniform"
                                   MaxWidth="300" MaxHeight="462"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SinglePreviewFallback" x:Uid="WidgetPickerPreviewUnavailable"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"
                                       Opacity="0.65" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="WidgetHeaderOverlay" Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="10"
                                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Image x:Name="WidgetIconImage" Width="48" Height="48" Stretch="Uniform"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="WidgetNameText" FontSize="22" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="WidgetActionOverlay" Grid.Row="0" Margin="10" ColumnSpacing="8" VerticalAlignment="Bottom"
                          IsHitTestVisible="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="SizeSelectorPanel" Grid.Column="0" Orientation="Horizontal"
                                        Spacing="8" VerticalAlignment="Center" IsHitTestVisible="True">
                                <TextBlock x:Uid="WidgetPickerSizeLabel" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SizeComboBox" Width="120" VerticalAlignment="Center"
                                          SelectionChanged="SizeComboBox_SelectionChanged"/>
                            </StackPanel>
                            <Button x:Name="AddButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                    Click="AddButton_Click" IsEnabled="False" IsHitTestVisible="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE718;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                    <TextBlock x:Name="AddButtonText" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                    </Grid>
                </Grid>
                <PipsPager x:Name="WidgetPagePager" Grid.Row="1" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" NumberOfPages="1"
                           PreviousButtonVisibility="VisibleOnPointerOver" NextButtonVisibility="VisibleOnPointerOver"
                           SelectedIndexChanged="WidgetPagePager_SelectedIndexChanged"
                           Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
