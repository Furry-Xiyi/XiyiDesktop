<UserControl
    x:Class="XiyiDesktop.Widgets.UI.WidgetPickerPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Border MaxWidth="300" MaxHeight="462"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Translation="0,0,32"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Image x:Name="WidgetPreviewImage" Stretch="Uniform"
                       MaxWidth="300" MaxHeight="462"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="WidgetPreviewFallbackText" x:Uid="WidgetPickerPreviewUnavailable"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Opacity="0.65"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
