<UserControl
    x:Class="XiyiDesktop.Widgets.UI.WidgetCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:systemBackdrops="using:Microsoft.UI.Xaml.Media"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">
    <Grid>
        <muxc:SystemBackdropElement x:Name="CardBackdrop" CornerRadius="16">
            <muxc:SystemBackdropElement.SystemBackdrop>
                <systemBackdrops:DesktopAcrylicBackdrop />
            </muxc:SystemBackdropElement.SystemBackdrop>
        </muxc:SystemBackdropElement>
        <Border x:Name="CardBorder" CornerRadius="16"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="ContentGrid" Grid.Row="0" Grid.RowSpan="2" Background="Transparent" MinHeight="90">
                <ContentPresenter x:Name="CardContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Grid x:Name="WebWidgetHost" Background="Transparent"
                      Visibility="Collapsed" IsHitTestVisible="False" />
                <TextBlock x:Name="AccentBrushProbe" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="CardRenderStateText" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="8,0,8,4" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="Collapsed" IsHitTestVisible="False" />
                <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing x:Name="LoadingRing" Width="48" Height="48" IsActive="False" />
                </StackPanel>
            </Grid>
            <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="15,7,15,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HeaderIdentityStack" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <Grid x:Name="ProviderIconContainer" Width="16" Height="16" VerticalAlignment="Center">
                        <Image x:Name="ProviderIcon" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed" />
                        <TextBlock x:Name="ProviderGlyph" Text="●" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                    </Grid>
                    <TextBlock x:Name="TitleText" Margin="8,0,0,0" VerticalAlignment="Center"
                               MaxWidth="180" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <Button x:Name="MenuButton" Grid.Column="1" Width="32" Height="32" MinWidth="32" Padding="0"
                        Background="Transparent" BorderThickness="0" Click="MenuButton_Click">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                </Button>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

