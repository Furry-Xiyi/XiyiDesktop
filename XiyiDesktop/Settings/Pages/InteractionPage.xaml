<Page
    x:Class="XiyiDesktop.Pages.InteractionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="InteractionPageTitle"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <muxc:SettingsCard x:Uid="Settings_SoundCard"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Stretch"
                                   Padding="16,10">
                <muxc:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;"/>
                </muxc:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="SoundToggle"
                              HorizontalAlignment="Right"
                              Toggled="SoundToggle_Toggled"/>
            </muxc:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
