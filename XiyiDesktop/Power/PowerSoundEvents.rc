#pragma code_page(65001)

#define IDS_APPLICATION_DISPLAY_NAME 50100
#define IDS_POWER_CONNECTED 50101
#define IDS_POWER_DISCONNECTED 50102

1 24 "app.manifest"

LANGUAGE 0x09, 0x01
STRINGTABLE
BEGIN
    IDS_APPLICATION_DISPLAY_NAME "Xiyi Desktop"
    IDS_POWER_CONNECTED "Power connected"
    IDS_POWER_DISCONNECTED "Power disconnected"
END

LANGUAGE 0x04, 0x02
STRINGTABLE
BEGIN
    IDS_APPLICATION_DISPLAY_NAME "惜忆桌面"
    IDS_POWER_CONNECTED "电源已接通"
    IDS_POWER_DISCONNECTED "电源已断开"
END
