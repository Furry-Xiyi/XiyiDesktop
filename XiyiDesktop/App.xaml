<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="XiyiDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <StaticResource x:Key="CommandBarFlyoutBackground" ResourceKey="LayerOnAcrylicFillColorDefaultBrush" />
            <Style x:Key="AcrylicMenuFlyoutPresenterBaseStyle" TargetType="muxc:MenuFlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
